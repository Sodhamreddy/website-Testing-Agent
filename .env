# Agentic engine (?engine=agentic). The browser stays local Playwright; this
# key just plans the audit + calls the bag-of-assets tools via an
# OpenAI-compatible endpoint.

# Get a free key: https://aistudio.google.com/apikey (Google account, no card).
# Set this locally — do NOT commit a real key.
AI_API_KEY=

# Gemini's OpenAI-compatibility endpoint — works with the plain OpenAI SDK.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Gemini 3.x (Sep 2026). NB: gemini-3.6-flash etc are REASONING models — 3-40s
# per call, too slow for the ~30-call exploration agent. The *-lite models skip
# most of that (~1-2s). gemini-2.5-flash / gemini-flash-latest = 20 req/DAY, avoid.
AI_MODEL=gemini-flash-lite-latest
AI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash

# Gemini free tier = ~20 requests/minute. 12 leaves headroom. The throttle
# spaces calls out; if you still get 429s, run one audit at a time.
AI_RPM=12
