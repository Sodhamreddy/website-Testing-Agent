# ─────────────────────────────────────────────────────────────────────────────
# BACKEND config — read by server/ at runtime via `tsx --env-file-if-exists=.env`
#
# Copy to `.env` and fill in AI_API_KEY. `.env` is gitignored — never commit it,
# and never upload it into a public web root (public_html) where it is
# downloadable at https://yourdomain.com/.env
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED. Free key, no card: https://aistudio.google.com/apikey
# server/agent/client.ts exits with a warning if this is unset.
AI_API_KEY=

# Gemini's OpenAI-compatibility endpoint — works with the plain OpenAI SDK.
# Optional; this is the built-in default.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Optional. NB: gemini-3.6-flash etc are REASONING models — 3-40s per call, too
# slow for the ~30-call exploration agent. The *-lite models skip most of that
# (~1-2s). gemini-2.5-flash / gemini-flash-latest = 20 req/DAY, avoid.
AI_MODEL=gemini-flash-lite-latest
AI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash

# Optional. Gemini free tier is ~20 requests/minute; 12 leaves headroom. The
# throttle spaces calls out. If you still get 429s, run one audit at a time.
AI_RPM=12

# Optional. Port the Express audit server listens on (default 8787).
# Nginx proxies /api to this; it should NOT be exposed publicly on its own.
PORT=8787


# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND config — read by Vite at BUILD time, inlined into dist/assets/*.js
#
# NOT A SECRET. Anything VITE_-prefixed ends up readable in the shipped bundle.
# Never put an API key here.
#
# Leave unset when frontend and backend share an origin (local dev, or Nginx
# proxying /api on the same domain). Set it when they are split — e.g. dist/ on
# Hostinger shared hosting, backend on a VPS. Must be https://.
# ─────────────────────────────────────────────────────────────────────────────

# VITE_API_BASE=https://api.yourdomain.com
