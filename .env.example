
# ─────────────────────────────────────────────────────────────────────────────
# The audit is a single AI exploration agent. Local Playwright drives the
# browser; this key is the "brain" that explores the site, deep-analyses each
# page (issues + GEO / AI-search recommendations), runs a security scan, and
# decides what to check. Any OpenAI-wire-compatible endpoint works — defaults
# point at Gemini's OpenAI-compat layer (free key, no card).
# ─────────────────────────────────────────────────────────────────────────────

# Free key: https://aistudio.google.com/apikey
AI_API_KEY=your-api-key

# Gemini's OpenAI-compat endpoint. For real OpenAI: https://api.openai.com/v1
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Model. The *-lite models are fast (~1s/call) and needed for the ~15-call agent
# — the full flash models "reason" for 10-40s/call and are too slow.
# Confirm live ids: GET {AI_BASE_URL}/models
AI_MODEL=gemini-flash-lite-latest

# Tried in order if the primary keeps failing (same provider/key). A dead id
# here is dropped automatically, not fatal.
AI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash

# Max requests/minute (sliding window). Gemini free tier is ~20/min.
AI_RPM=12
